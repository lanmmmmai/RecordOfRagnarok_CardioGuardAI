#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to `secrets.h` and fill in your own values.
// `secrets.h` is listed in .gitignore and must never be committed: anyone
// holding the bot token can send messages that look like they came from the
// watch.

// Wi-Fi the watch joins for internet access.
#define WIFI_SSID_DEFAULT "YourNetworkName"
#define WIFI_PASS_DEFAULT "YourNetworkPassword"

// Telegram Bot.
//   Token   : talk to @BotFather, send /newbot, copy the token it replies with.
//   Chat ID : send any message to your bot, then open
//             https://api.telegram.org/bot<TOKEN>/getUpdates
//             and read result[0].message.chat.id
// For a group chat the ID is negative; include the minus sign.
#define TELEGRAM_BOT_TOKEN "123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#define TELEGRAM_CHAT_ID   "123456789"

#endif // SECRETS_H
